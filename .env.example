# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_DATA_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Plaid Webhooks
# Get PLAID_WEBHOOK_SECRET from Plaid Dashboard → Developers → Webhooks → Verification
# Set NEXT_PUBLIC_APP_URL to your production domain (e.g. https://your-app.vercel.app)
# For local dev, webhooks require a tunnel (e.g. ngrok) — leave blank to skip webhook registration
PLAID_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEV_TOOLS=false

# Testing (Playwright)
TEST_EMAIL=
TEST_PASSWORD=

# RentCast (property values and comparable sales)
# Server-only. Never expose this to the browser: there is no per-user quota,
# only one account-wide allowance, so a leaked key spends the month's requests.
RENTCAST_API_KEY=

# live | mock — leave blank.
# Blank is the correct setting everywhere. The app then decides from VERCEL_ENV:
# production calls RentCast, and preview, Vercel development, local and CI all
# serve fixtures from lib/rentcast/fixtures. That way a preview deploy cannot
# spend the monthly allowance.
# Set "live" only for a deliberate local check against the real API (it costs a
# request), or "mock" to force fixtures in production.
RENTCAST_MODE=
